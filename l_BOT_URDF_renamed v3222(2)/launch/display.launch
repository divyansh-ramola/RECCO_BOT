<launch>
  <arg
    name="model" />
  <param
    name="robot_description"
    textfile="$(find l_BOT_URDF_renamed v3222(2))/urdf/l_BOT_URDF_renamed v3222(2).urdf" />
  <node
    name="joint_state_publisher_gui"
    pkg="joint_state_publisher_gui"
    type="joint_state_publisher_gui" />
  <node
    name="robot_state_publisher"
    pkg="robot_state_publisher"
    type="robot_state_publisher" />
  <node
    name="rviz"
    pkg="rviz"
    type="rviz"
    args="-d $(find l_BOT_URDF_renamed v3222(2))/urdf.rviz" />
</launch>