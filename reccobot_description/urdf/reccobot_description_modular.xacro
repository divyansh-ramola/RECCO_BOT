<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="reccobot_description">
  <xacro:property name="mesh_dir" value="package://reccobot_description/meshes"/>
  <xacro:property name="color_base" value="0.960 0.620 0.043 1.0"/>
  <xacro:property name="color_servo_blue" value="0.231 0.510 0.961 1.0"/>
  <xacro:property name="color_servo_green" value="0.063 0.722 0.506 1.0"/>
  <xacro:property name="color_struct_gray" value="0.616 0.639 0.686 1.0"/>
  <xacro:property name="color_sensor_purple" value="0.659 0.333 0.969 1.0"/>

  <!-- Centralized hardware interface names -->
  <xacro:property name="hardware_interface_position" value="PositionJointInterface"/>
  <xacro:property name="hardware_interface_effort" value="EffortJointInterface"/>

  <xacro:property name="joint_k_position_active" value="20.0"/>
  <xacro:property name="joint_k_velocity_active" value="10.0"/>

  <xacro:property name="joint_limit_servo_lower" value="-1.396"/>
  <xacro:property name="joint_limit_servo_upper" value="1.396"/>
  <xacro:property name="joint_effort_servo" value="1.2"/>
  <xacro:property name="joint_velocity_servo" value="6.0"/>
  <xacro:property name="joint_damping_servo" value="0.04"/>
  <xacro:property name="joint_friction_servo" value="0.02"/>

  <xacro:property name="joint_limit_femur_lower" value="-1.57"/>
  <xacro:property name="joint_limit_femur_upper" value="1.57"/>
  <xacro:property name="joint_effort_femur" value="2.0"/>
  <xacro:property name="joint_velocity_femur" value="7.5"/>
  <xacro:property name="joint_damping_femur" value="0.05"/>
  <xacro:property name="joint_friction_femur" value="0.03"/>

  <xacro:property name="joint_k_position_passive" value="5"/>
  <xacro:property name="joint_k_velocity_passive" value="0.1"/>

  <xacro:property name="joint_limit_feet_lower" value="-0.785"/>
  <xacro:property name="joint_limit_feet_upper" value="0.785"/>
  <xacro:property name="joint_effort_feet" value="0"/>
  <xacro:property name="joint_velocity_feet" value="10"/>
  <xacro:property name="joint_damping_feet" value="0.2"/>
  <xacro:property name="joint_friction_feet" value="0.05"/>
  <xacro:property name="joint_soft_limit_feet_lower" value="-0.7"/>
  <xacro:property name="joint_soft_limit_feet_upper" value="0.7"/>

  <xacro:property name="joint_limit_camera_lower" value="-1.396"/>
  <xacro:property name="joint_limit_camera_upper" value="1.396"/>
  <xacro:property name="joint_effort_camera" value="0.8"/>
  <xacro:property name="joint_velocity_camera" value="5.0"/>
  <xacro:property name="joint_damping_camera" value="0.03"/>
  <xacro:property name="joint_friction_camera" value="0.015"/>

  <xacro:property name="joint_limit_lidar_lower" value="-6.283"/>
  <xacro:property name="joint_limit_lidar_upper" value="6.283"/>
  <xacro:property name="joint_effort_lidar" value="2.5"/>
  <xacro:property name="joint_velocity_lidar" value="3.5"/>
  <xacro:property name="joint_damping_lidar" value="0.02"/>
  <xacro:property name="joint_friction_lidar" value="0.01"/>

  <xacro:property name="joint_limit_coupling_lower" value="-6.28"/>
  <xacro:property name="joint_limit_coupling_upper" value="6.25"/>
  <xacro:property name="joint_effort_coupling" value="0.5"/>
  <xacro:property name="joint_velocity_coupling" value="0.6"/>
  <xacro:property name="joint_damping_coupling" value="0.02"/>
  <xacro:property name="joint_friction_coupling" value="0.01"/>
  <xacro:property name="joint_soft_limit_coupling_lower" value="-6"/>
  <xacro:property name="joint_soft_limit_coupling_upper" value="6"/>
  <xacro:property name="joint_k_velocity_coupling" value="0.2"/>

  <!-- ================================================================== -->
  <!-- Generic macros to keep the description DRY and easier to mod.      -->
  <!-- ================================================================== -->
  <xacro:macro name="mesh_link" params="name mesh rgba origin_xyz:='0 0 0' origin_rpy:='0 0 0'">
    <link name="${name}">
      <xacro:insert_block name="inertial"/>
      <visual>
        <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
        <geometry>
          <mesh filename="${mesh}"/>
        </geometry>
        <material name="${name}_mat">
          <color rgba="${rgba}"/>
        </material>
      </visual>
      <collision>
        <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
        <geometry>
          <mesh filename="${mesh}"/>
        </geometry>
      </collision>
      <xacro:insert_block name="extras"/>
    </link>
  </xacro:macro>

  <xacro:macro name="fixed_joint" params="name parent child origin_xyz origin_rpy axis:='0 0 0'">
    <joint name="${name}" type="fixed">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
      <axis xyz="${axis}"/>
      <xacro:insert_block name="extras"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="actuated_joint" params="name type:='revolute' parent child origin_xyz origin_rpy axis interface:='PositionJointInterface' lower upper effort velocity damping friction soft_lower soft_upper k_position:='${joint_k_position_active}' k_velocity:='${joint_k_velocity_active}'">
    <joint name="${name}" type="${type}">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
      <axis xyz="${axis}"/>
      <limit lower="${lower}" upper="${upper}" effort="${effort}" velocity="${velocity}"/>
      <dynamics damping="${damping}" friction="${friction}"/>
      <safety_controller soft_lower_limit="${soft_lower}" soft_upper_limit="${soft_upper}" k_position="${k_position}" k_velocity="${k_velocity}"/>
      <xacro:insert_block name="extras"/>
    </joint>
    <ros2_control>
      <joint name="${name}">
        <hardware_interface>${interface}</hardware_interface>
        <calibration rising="0.0" falling="0.0"/>
        <limit effort="${effort}" velocity="${velocity}" lower="${lower}" upper="${upper}"/>
        <dynamics damping="${damping}" friction="${friction}"/>
        <safety_controller k_position="${k_position}" k_velocity="${k_velocity}" soft_lower_limit="${soft_lower}" soft_upper_limit="${soft_upper}"/>
      </joint>
    </ros2_control>
    <calibration rising="0.0" falling="0.0"/>
  </xacro:macro>

  <xacro:macro name="passive_joint" params="name type:='revolute' parent child origin_xyz origin_rpy axis lower upper effort velocity damping friction soft_lower soft_upper k_position:='${joint_k_position_passive}' k_velocity:='${joint_k_velocity_passive}'">
    <joint name="${name}" type="${type}">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
      <axis xyz="${axis}"/>
      <limit lower="${lower}" upper="${upper}" effort="${effort}" velocity="${velocity}"/>
      <dynamics damping="${damping}" friction="${friction}"/>
      <safety_controller soft_lower_limit="${soft_lower}" soft_upper_limit="${soft_upper}" k_position="${k_position}" k_velocity="${k_velocity}"/>
      <xacro:insert_block name="extras"/>
    </joint>
  </xacro:macro>

  <!-- ================================================================== -->
  <!-- Robot description                                                  -->
  <!-- ================================================================== -->

  <link name="world"/>

  <!-- === Base Assembly === -->
  <xacro:mesh_link name="base_link" mesh="${mesh_dir}/base_link.STL" rgba="${color_base}">
    <inertial>
      <origin xyz="-0.22536 -0.06397 0.12957" rpy="0 0 0"/>
      <mass value="0.21673"/>
      <inertia ixx="0.00046806" ixy="1.2348E-05" ixz="2.9514E-06" iyy="0.00067187" iyz="1.3398E-06" izz="0.00091551"/>
    </inertial>
  </xacro:mesh_link>

  <xacro:fixed_joint name="world_to_base" parent="world" child="base_link" origin_xyz="0 0 0" origin_rpy="-1.5708 0 0"/>

  <!-- === Leg 1 === -->
