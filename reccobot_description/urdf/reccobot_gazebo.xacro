<?xml version="1.0"?>
<!-- Gazebo tuning snippet for reccobot -->
<!-- Note: ros2_control plugin is defined in reccobot_ros2_control.xacro -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<gazebo reference="coxa1j">
  <kp>80</kp>
  <ki>0.5</ki>
  <kd>2.0</kd>
  <friction>0.02</friction>
  <damping>0.04</damping>
  <maxEffort>0.98</maxEffort>
  <provideFeedback>true</provideFeedback>
</gazebo>
