<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="reccobot">

  <!-- Use sim_mode arg to switch between Gazebo sim and real hardware plugins -->
  <xacro:arg name="sim_mode" default="true"/>

  <xacro:property name="PI" value="3.14159265359" />
  <xacro:property name="limit_servo" value="1.396" />
  <xacro:property name="limit_femur" value="${PI / 2}" />

  <!-- ==================== SIMULATION MODE ==================== -->
  <xacro:if value="$(arg sim_mode)">
    <!-- ros2_control for Gazebo (ros_gz_sim) - all joints use Gazebo plugin -->
    <ros2_control name="ReccobotSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

    <!-- Legs: position-controlled servos (exclude passive feet joints) -->
    <joint name="coxa1j">
      <command_interface name="position">15
        <param name="min">${-limit_servo}</param>
        <param name="max">${limit_servo}</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="femur1j">
      <command_interface name="position">
        <param name="min">${-limit_femur}</param>
        <param name="max">${limit_femur}</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="tibia1j">
      <command_interface name="position">
        <param name="min">${-limit_servo}</param>
        <param name="max">${limit_servo}</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

    <joint name="coxa2j">
      <command_interface name="position">
        <param name="min">${-limit_servo}</param>
        <param name="max">${limit_servo}</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="femur2j">
      <command_interface name="position">
        <param name="min">${-limit_femur}</param>
        <param name="max">${limit_femur}</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="tibia2j">
      <command_interface name="position">
        <param name="min">${-limit_servo}</param>
        <param name="max">${limit_servo}</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

    <joint name="coxa3j">
      <command_interface name="position">
        <param name="min">${-limit_servo}</param>
        <param name="max">${limit_servo}</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="femur3j">
      <command_interface name="position">
        <param name="min">${-limit_femur}</param>
        <param name="max">${limit_femur}</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="tibia3j">
      <command_interface name="position">
        <param name="min">${-limit_servo}</param>
        <param name="max">${limit_servo}</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

    <joint name="coxa4j">
      <command_interface name="position">
        <param name="min">${-limit_servo}</param>
        <param name="max">${limit_servo}</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="femur4j">
      <command_interface name="position">
        <param name="min">${-limit_femur}</param>
        <param name="max">${limit_femur}</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="tibia4j">
      <command_interface name="position">
        <param name="min">${-limit_servo}</param>
        <param name="max">${limit_servo}</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

    <!-- Optional: camera gimbal joints -->
    <joint name="cambase_caml1">
      <command_interface name="position">
        <param name="min">${-limit_servo}</param>
        <param name="max">${limit_servo}</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>
    <joint name="caml1_caml2">
      <command_interface name="position">
        <param name="min">${-limit_servo}</param>
        <param name="max">${limit_servo}</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

    <!-- Lidar rotation joint -->
    <joint name="base_coupling">
      <command_interface name="position">
        <param name="min">-6.28</param>
        <param name="max">6.28</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <!-- Passive feet joints - state-only (no command interface) -->
    <joint name="feet1j">
      <state_interface name="position"/>
    </joint>
    <joint name="feet2j">
      <state_interface name="position"/>
    </joint>
    <joint name="feet3j">
      <state_interface name="position"/>
    </joint>
    <joint name="feet4j">
      <state_interface name="position"/>
    </joint>
  </ros2_control>

  <!-- ros2_control plugin injection for Gazebo (ros_gz_sim) -->
  <gazebo>
    <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="libgz_ros2_control-system.so">
      <parameters>$(find reccobot_description)/config/reccobot_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>